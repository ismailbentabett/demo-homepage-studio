{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demo site facts",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "trade", "direction", "biz", "services", "proof", "seo", "demo"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+-[ABC]$" },
    "trade": { "type": "string", "pattern": "^[a-z]+$" },
    "direction": { "enum": ["A", "B", "C"] },
    "biz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "short", "initials", "slug", "owner", "tradeLabel", "schemaType", "phone", "phoneE164", "sms", "email", "city", "state", "stateName", "timezone", "areas", "zips", "hours", "emergency"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 40 },
        "short": { "type": "string", "minLength": 2, "maxLength": 18 },
        "initials": { "type": "string", "pattern": "^[A-Z&]{1,3}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "owner": { "type": "string", "pattern": "^[A-Z][a-z]+( [A-Z]\\.)?$" },
        "tradeLabel": { "type": "string" },
        "schemaType": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
        "phone": { "type": "string", "pattern": "^\\([2-9][0-9]{2}\\) 555-01[0-9]{2}$" },
        "phoneE164": { "type": "string", "pattern": "^\\+1[2-9][0-9]{2}55501[0-9]{2}$" },
        "sms": { "type": "boolean" },
        "email": { "type": "string", "pattern": "^hello@[a-z0-9-]+\\.example$" },
        "city": { "type": "string" },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "stateName": { "type": "string" },
        "timezone": { "type": "string", "pattern": "^America/" },
        "areas": { "type": "array", "minItems": 4, "maxItems": 14, "items": { "type": "string" } },
        "zips": { "type": "array", "minItems": 5, "maxItems": 40, "items": { "type": "string", "pattern": "^[0-9]{5}$" } },
        "hours": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
          "patternProperties": {
            "^(mon|tue|wed|thu|fri|sat|sun)$": {
              "oneOf": [
                { "type": "null" },
                { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } }
              ]
            }
          }
        },
        "emergency": { "type": "boolean" },
        "familyOwned": { "type": "boolean" }
      }
    },
    "services": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "short", "blurb"],
        "properties": {
          "name": { "type": "string", "maxLength": 40 },
          "short": { "type": "string", "maxLength": 22 },
          "blurb": { "type": "string", "minLength": 30, "maxLength": 140 }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "rating", "reviewCount", "reviews", "prices"],
      "properties": {
        "label": { "const": "Sample" },
        "rating": { "type": "number", "minimum": 4.5, "maximum": 5 },
        "reviewCount": { "type": "integer", "minimum": 20, "maximum": 900 },
        "reviews": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "name", "town", "service"],
            "properties": {
              "text": { "type": "string", "minLength": 80, "maxLength": 380 },
              "name": { "type": "string", "pattern": "^[A-Z][a-z]+ [A-Z]\\.$" },
              "town": { "type": "string" },
              "service": { "type": "string" },
              "stars": { "type": "integer", "minimum": 4, "maximum": 5 }
            }
          }
        },
        "guarantee": { "type": "string", "maxLength": 140 },
        "license": { "type": "string", "pattern": "^SAMPLE-" },
        "insured": { "type": "boolean" },
        "years": { "type": "integer", "minimum": 3, "maximum": 45 },
        "prices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "from"],
            "properties": {
              "item": { "type": "string" },
              "from": { "type": "string", "pattern": "^\\$[0-9][0-9,]*$" },
              "to": { "type": "string", "pattern": "^\\$[0-9][0-9,]*$" },
              "unit": { "type": "string" },
              "note": { "type": "string", "maxLength": 60 }
            }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 50, "maxLength": 60 },
        "description": { "type": "string", "minLength": 120, "maxLength": 155 }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclaimer"],
      "properties": { "disclaimer": { "type": "string" } }
    }
  }
}
